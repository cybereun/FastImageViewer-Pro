{
  "name": "fast-image-viewer",
  "private": true,
  "version": "2.2.0",
  "description": "Fast local-first desktop image browser and organizer",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "node scripts/build-edition.mjs community",
    "electron:build:community": "node scripts/build-edition.mjs community",
    "electron:build:pro": "node scripts/build-edition.mjs pro"
  },
  "author": "Lebi_Cybereun",
  "license": "MIT",
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "electron-is-dev": "^3.0.0",
    "lightningcss-win32-x64-msvc": "^1.30.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.antigravity.fastimage",
    "productName": "FastImage",
    "copyright": "Copyright © 2026 Lebi_Cybereun",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FastImage-${version}-Windows-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FastImage",
      "runAfterFinish": true,
      "useZip": false,
      "artifactName": "FastImage-${version}-Windows-Setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "gif",
          "bmp",
          "webp",
          "svg",
          "ico",
          "tif",
          "tiff",
          "avif"
        ],
        "name": "FastImage Image",
        "role": "Editor"
      }
    ]
  }
}
